# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=amp

# Make this the same as your github username/organisation
REPO_ORGANIZATION="mheci"

IMAGE_DESC="Personal Universal Blue Kinoite image with NVIDIA open drivers, Terra, RPM Fusion, codecs, and developer tools"
IMAGE_KEYWORDS="bootc,oci,linux,kinoite,nvidia,universal-blue,android,opencode,t3code"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://github.com/mheci.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
